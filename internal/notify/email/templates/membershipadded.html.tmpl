{{define "content" -}}
{{- $product := .ProductName}}{{if not $product}}{{$product = "Open Control Plane"}}{{end -}}

<!-- heading with inline CP thumbnail -->
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 14px;">
<tr>
  <td style="width:80px; padding:0 16px 0 0; vertical-align:middle; line-height:0; font-size:0;">
    <img src="{{cpBannerDataURI}}" alt="" width="80"
         style="display:block; width:80px; height:auto; border-radius:6px;" />
  </td>
  <td style="vertical-align:middle;">
    <h1 style="margin:0; font-size:21px; line-height:27px; color:#012931; font-weight:700;">
      You've been added to a {{.ResourceKind}}
    </h1>
  </td>
</tr>
</table>
<p style="margin:0 0 14px; font-size:15px; line-height:23px; color:#33363a;">
  Hi{{if .RecipientName}} {{.RecipientName}}{{end}},
</p>
<p style="margin:0 0 22px; font-size:15px; line-height:23px; color:#33363a;">
  You have been granted the <strong style="color:#07838F;">{{.Role}}</strong> role on the
  {{.ResourceKind}} <strong>{{if .ResourceDisplayName}}{{.ResourceDisplayName}}{{else}}{{.ResourceName}}{{end}}</strong>{{if .Actor}} by {{.Actor}}{{end}}.
</p>

<!-- Details card -->
<table role="presentation" cellpadding="0" cellspacing="0" width="100%"
       style="margin:0 0 26px; background-color:#f5fffe; border-radius:7px; border-left:4px solid #2CE0BF;">
<tr><td style="padding:16px 20px; font-size:14px; line-height:22px; color:#33363a;">
  <strong>{{.ResourceKind}}:</strong>&nbsp;{{.ResourceName}}<br />
  <strong>Role:</strong>&nbsp;<span style="color:#07838F;">{{.Role}}</span>
</td></tr>
</table>

{{if .ConsoleURL -}}
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
<td style="border-radius:7px; background-color:#07838F;">
  <a href="{{.ConsoleURL}}" style="display:inline-block; padding:12px 26px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">
    Open in webapp &#8594;
  </a>
</td>
{{if .ConnectURL -}}
<td style="width:14px;">&nbsp;</td>
<td style="border-radius:7px; border:2px solid #07838F;">
  <a href="{{.ConnectURL}}" style="display:inline-block; padding:10px 24px; font-size:15px; font-weight:600; color:#07838F; text-decoration:none;">
    Get kubeconfig
  </a>
</td>
{{- end}}
</tr></table>
{{- end}}
{{if .SupportURL -}}
<p style="margin:18px 0 0; font-size:12px; line-height:18px; color:#98989f;">
  <strong>Found a bug or have a request?</strong> <a href="{{.SupportURL}}" style="color:#98989f; text-decoration:underline; font-weight:700;">Create support issue.</a>
</p>
{{- end}}
{{- end}}
