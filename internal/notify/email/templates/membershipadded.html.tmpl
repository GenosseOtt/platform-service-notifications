{{define "content" -}}
<h1 style="margin:0 0 16px; font-size:22px; line-height:28px; color:#1a1a1a;">You've been added to a {{.ResourceKind}}</h1>
<p style="margin:0 0 16px; font-size:15px; line-height:22px; color:#33363a;">
Hi{{if .RecipientName}} {{.RecipientName}}{{end}},
</p>
<p style="margin:0 0 20px; font-size:15px; line-height:22px; color:#33363a;">
You have been granted the <strong>{{.Role}}</strong> role on the {{.ResourceKind}}
<strong>{{if .ResourceDisplayName}}{{.ResourceDisplayName}}{{else}}{{.ResourceName}}{{end}}</strong>{{if .Actor}} by {{.Actor}}{{end}}.
</p>
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 0 24px; width:100%; background-color:#f7f8fa; border-radius:6px;">
<tr><td style="padding:16px 20px; font-size:14px; line-height:20px; color:#33363a;">
<strong>{{.ResourceKind}}:</strong> {{.ResourceName}}<br />
<strong>Role:</strong> {{.Role}}
</td></tr>
</table>
{{if .ConsoleURL -}}
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="border-radius:6px; background-color:#0a6ed1;">
<a href="{{.ConsoleURL}}" style="display:inline-block; padding:12px 24px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">Open in console</a>
</td></tr></table>
{{- end}}
{{- end}}
