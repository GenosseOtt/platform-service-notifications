{{define "content" -}}
<h1 style="margin:0 0 16px; font-size:22px; line-height:28px; color:#1a1a1a;">A new version of {{.ServiceName}} is available</h1>
<p style="margin:0 0 16px; font-size:15px; line-height:22px; color:#33363a;">
Hi{{if .RecipientName}} {{.RecipientName}}{{end}},
</p>
<p style="margin:0 0 20px; font-size:15px; line-height:22px; color:#33363a;">
Version <strong>{{.NewVersion}}</strong> of <strong>{{.ServiceName}}</strong> is now available.
The following control plane{{if ne (len .AffectedControlPlanes) 1}}s you administer use{{else}} you administer uses{{end}} this service:
</p>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 24px; border-collapse:collapse; font-size:14px;">
<tr style="background-color:#f7f8fa;">
<th align="left" style="padding:10px 12px; color:#6a6d70; font-weight:600; border-bottom:1px solid #e3e6ea;">Control plane</th>
<th align="left" style="padding:10px 12px; color:#6a6d70; font-weight:600; border-bottom:1px solid #e3e6ea;">Namespace</th>
<th align="left" style="padding:10px 12px; color:#6a6d70; font-weight:600; border-bottom:1px solid #e3e6ea;">Current</th>
</tr>
{{range .AffectedControlPlanes -}}
<tr>
<td style="padding:10px 12px; color:#1a1a1a; border-bottom:1px solid #eef0f2;">{{if .ConsoleURL}}<a href="{{.ConsoleURL}}" style="color:#0a6ed1; text-decoration:none;">{{.Name}}</a>{{else}}{{.Name}}{{end}}</td>
<td style="padding:10px 12px; color:#33363a; border-bottom:1px solid #eef0f2;">{{.Namespace}}</td>
<td style="padding:10px 12px; color:#33363a; border-bottom:1px solid #eef0f2;">{{if .CurrentVersion}}{{.CurrentVersion}}{{else}}&mdash;{{end}}</td>
</tr>
{{end -}}
</table>
{{if .ConsoleURL -}}
<table role="presentation" cellpadding="0" cellspacing="0"><tr><td style="border-radius:6px; background-color:#0a6ed1;">
<a href="{{.ConsoleURL}}" style="display:inline-block; padding:12px 24px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">Review upgrades</a>
</td></tr></table>
{{- end}}
{{- end}}
