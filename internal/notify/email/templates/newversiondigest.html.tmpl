{{define "content" -}}
{{- $product := .ProductName}}{{if not $product}}{{$product = "Open Control Plane"}}{{end -}}

<!-- heading with inline CP thumbnail -->
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="margin:0 0 14px;">
<tr>
  <td style="width:80px; padding:0 16px 0 0; vertical-align:middle; line-height:0; font-size:0;">
    <img src="{{cpBannerDataURI}}" alt="" width="80"
         style="display:block; width:80px; height:auto; border-radius:6px;" />
  </td>
  <td style="vertical-align:middle;">
    <h1 style="margin:0; font-size:21px; line-height:27px; color:#012931; font-weight:700;">
      New version of <strong style="color:#07838F;">{{.ServiceName}}</strong> available
    </h1>
  </td>
</tr>
</table>
<p style="margin:0 0 14px; font-size:15px; line-height:23px; color:#33363a;">
  Hi{{if .RecipientName}} {{.RecipientName}}{{end}},
</p>
<p style="margin:0 0 22px; font-size:15px; line-height:23px; color:#33363a;">
  Version <strong style="background-color:#f5fffe; color:#049F9A; padding:1px 6px; border-radius:4px; font-family:monospace;">{{.NewVersion}}</strong>
  of <strong>{{.ServiceName}}</strong> is now available on {{$product}}.
  The following control plane{{if ne (len .AffectedControlPlanes) 1}}s use{{else}} uses{{end}} this service:
</p>

<!-- CP table -->
<table role="presentation" cellpadding="0" cellspacing="0" width="100%"
       style="margin:0 0 26px; border-collapse:collapse; font-size:14px; border-radius:7px; overflow:hidden; border:1px solid #e3e6ea;">
<tr style="background-color:#012931;">
  <th align="left" style="padding:10px 14px; color:#2CE0BF; font-weight:600; font-size:12px; letter-spacing:0.5px; text-transform:uppercase; white-space:nowrap;">Control Plane</th>
  <th align="left" style="padding:10px 14px; color:#2CE0BF; font-weight:600; font-size:12px; letter-spacing:0.5px; text-transform:uppercase; white-space:nowrap;">Workspace</th>
  <th align="left" style="padding:10px 14px; color:#2CE0BF; font-weight:600; font-size:12px; letter-spacing:0.5px; text-transform:uppercase; white-space:nowrap;">Current</th>
</tr>
{{range .AffectedControlPlanes -}}
<tr>
  <td style="padding:11px 14px; color:#1a1a1a; border-bottom:1px solid #eef0f2; font-weight:500;">
    {{if .ConsoleURL}}<a href="{{.ConsoleURL}}" style="color:#07838F; text-decoration:none;">{{.Name}}</a>{{else}}{{.Name}}{{end}}
  </td>
  <td style="padding:11px 14px; color:#515c67; border-bottom:1px solid #eef0f2;">{{.Namespace}}</td>
  <td style="padding:11px 14px; color:#515c67; border-bottom:1px solid #eef0f2; font-family:monospace; font-size:13px;">
    {{if .CurrentVersion}}{{.CurrentVersion}}{{else}}&mdash;{{end}}
  </td>
</tr>
{{end -}}
</table>

{{if .ConsoleURL -}}
<table role="presentation" cellpadding="0" cellspacing="0"><tr>
<td style="border-radius:7px; background-color:#07838F;">
  <a href="{{.ConsoleURL}}" style="display:inline-block; padding:12px 26px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">
    Open in webapp &#8594;
  </a>
</td>
</tr></table>
{{- end}}
{{if .SupportURL -}}
<p style="margin:18px 0 0; font-size:12px; line-height:18px; color:#98989f;">
  <strong>Found a bug or have a request?</strong> <a href="{{.SupportURL}}" style="color:#98989f; text-decoration:underline; font-weight:700;">Create support issue.</a>
</p>
{{- end}}
{{- end}}
