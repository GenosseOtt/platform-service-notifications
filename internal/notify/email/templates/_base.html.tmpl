{{define "layout" -}}
{{- $product := .ProductName}}{{if not $product}}{{$product = "Open Control Plane"}}{{end -}}
<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>{{$product}}</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f2f5; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f0f2f5;">
<tr>
<td align="center" style="padding:28px 12px 40px;">

<!-- Outer card -->
<table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%; border-radius:10px; overflow:hidden; box-shadow:0 2px 12px rgba(1,41,49,0.14);">

  <!-- ── Header ── -->
  <tr>
    <td style="background-color:#012931; padding:22px 32px 18px;" align="center">
      <img src="{{logoDataURI}}" alt="{{$product}}" width="234" height="auto"
           style="display:block; max-width:234px; height:auto;" />
    </td>
  </tr>
  <!-- accent bar -->
  <tr><td style="background-color:#07838F; height:3px; font-size:0; line-height:0;">&nbsp;</td></tr>

  <!-- ── Content ── -->
  <tr>
    <td style="background-color:#ffffff; padding:36px 36px 28px;">
      {{template "content" .}}
    </td>
  </tr>

  <!-- ── Footer ── -->
  <tr>
    <td style="background-color:#012931; padding:20px 32px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td style="padding-bottom:14px;">
          <p style="margin:0; color:#98989f; font-size:11px; line-height:17px;">
            You received this message because of activity on the {{$product}} platform.
            To manage what you are notified about, create a
            <code style="font-family:monospace; background-color:#02414c; color:#2CE0BF; padding:1px 4px; border-radius:3px;">UserNotificationOptOut</code>
            on your workspace.
          </p>
        </td>
      </tr>
      <tr>
        <td align="center" style="padding-top:10px; border-top:1px solid #02414c;">
          <img src="{{footerBadgeDataURI}}" alt="Co-funded by the European Union" width="220" height="auto"
               style="display:inline-block; max-width:220px; height:auto; opacity:0.85;" />
        </td>
      </tr>
      </table>
    </td>
  </tr>

</table>
<!-- /card -->

</td>
</tr>
</table>
</body>
</html>
{{- end}}
